<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pararius.react</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PY__</string>
        <string>__APPDIR__/pararius_react.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>WorkingDirectory</key>
    <string>__APPDIR__</string>
    <key>StandardOutPath</key>
    <string>__APPDIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__APPDIR__/launchd.err.log</string>
</dict>
</plist>
